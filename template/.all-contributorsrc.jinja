{
  "projectName": "{{ project_slug }}",
  "projectOwner": "{{ repository_owner }}",
  "repoType": "github",
  "repoHost": "https://github.com",
  "files": [
    "README.md"
  ],
  "imageSize": 100,
  "commit": false,
  "commitConvention": "none",
  "contributors": [
    {
      "login": {{ github_user }},
      "name": {{ author_name }},
      "avatar_url": "https://github.com/{{ github_user }}.png?v=4",
      "profile": "https://github.com/{{ github_user }}",
      "contributions": [
        "code",
        "doc",
        "ideas",
        "projectManagement",
        "maintenance"
      ],
      "firstContribution": "{{ '%Y-%m-%d' | strftime }}"
    }
  ],
  "contributorsPerLine": 7,
  "linkToUsage": false,
  "contributorsSortAlphabetically": false
}

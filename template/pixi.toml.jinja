[workspace]
name = "{{ project_slug }}"
channels = ["conda-forge"]
exclude-newer = "7d"
platforms = ["osx-arm64", "osx-64", "linux-64", "win-64"]
preview = ["pixi-build"]

[package]
name = "{{ project_slug }}"

[package.build.backend]
name = "pixi-build-python"
version = "*"

[package.host-dependencies]
python = ">={{ minimal_python_version.replace('py3', '3.') }}"
hatchling = "*"
uv = "*"

[dependencies]
{{ project_slug if "." not in project_slug else ('"' ~ project_slug ~ '"') }} = { path = "." }

[feature.test.dependencies]
pytest = "*"
pytest-cov = "*"
mypy = "*"

[feature.test.tasks]
test = "pytest"
test-coverage = "pytest --cov={{ project_slug_snake_case }} --cov-report=xml --cov-report=term-missing"

[feature.build.dependencies]
python = "*"
hatchling = "*"
python-build = "*"
twine = ">=6"

[feature.build.tasks]
build-wheel = "python -m build --no-isolation ."
check-wheel = "twine check dist/*"

[feature.lint.dependencies]
lefthook = "*"
ruff = "*"
prettier = "*"
tombi = "*"
pre-commit-hooks = "*"
typos = "*"
zizmor = "*"
conda-deny = "*"

[feature.lint.tasks]
pre-commit-install = "lefthook install"
lint = "lefthook run pre-commit --all-files"
conda-deny-check = "conda-deny check"
{%- if minimal_python_version <= "py310" %}

[feature.py310.dependencies]
python = "3.10.*"
{%- endif %}
{%- if minimal_python_version <= "py311" %}

[feature.py311.dependencies]
python = "3.11.*"
{%- endif %}
{%- if minimal_python_version <= "py312" %}

[feature.py312.dependencies]
python = "3.12.*"
{%- endif %}
{%- if minimal_python_version <= "py313" %}

[feature.py313.dependencies]
python = "3.13.*"
{%- endif %}
{%- if minimal_python_version <= "py314" %}

[feature.py314.dependencies]
python = "3.14.*"
{%- endif %}

[environments]
default = ["test", "build", "lint"]
{%- if minimal_python_version <= "py310" %}
py310 = ["py310", "test"]
{%- endif %}
{%- if minimal_python_version <= "py311" %}
py311 = ["py311", "test"]
{%- endif %}
{%- if minimal_python_version <= "py312" %}
py312 = ["py312", "test"]
{%- endif %}
{%- if minimal_python_version <= "py313" %}
py313 = ["py313", "test"]
{%- endif %}
{%- if minimal_python_version <= "py314" %}
py314 = ["py314", "test"]
{%- endif %}

[tool.conda-deny]
# Starter allowlist for the generated development and test environments.
# Review this list for your project before adding dependencies.
safe-licenses = [
  "0BSD",
  "AFL-2.1",
  "Apache-2.0",
  "Apache-2.0 WITH LLVM-exception",
  "BSD-2-Clause",
  "BSD-3-Clause",
  "EPL-2.0",
  "GPL-3.0-only",
  "GPL-3.0-only WITH GCC-exception-3.1",
  "ISC",
  "LGPL-2.1-only",
  "LGPL-2.1-or-later",
  "LGPL-3.0-only",
  "MIT",
  "MPL-2.0",
  "PSF-2.0",
  "Python-2.0",
  "TCL",
  "X11",
  "Zlib",
  "blessing",
  "bzip2-1.0.6",
  "LicenseRef-Public-Domain",
  # Windows runtime dependencies distributed through conda-forge.
  "LicenseRef-MicrosoftVisualCpp2015-2022Runtime",
  "LicenseRef-MicrosoftWindowsSDK10",
]
# Exclude the local project; this check covers third-party dependencies.
ignore-packages = [{ package = "{{ project_slug }}" }]

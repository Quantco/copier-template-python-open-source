[workspace]
name = "{{ project_slug }}"
channels = ["conda-forge"]
exclude-newer = "7d"
platforms = ["osx-arm64", "osx-64", "linux-64", "win-64"]
preview = ["pixi-build"]

[package]
name = "{{ project_slug }}"
[package.build.backend]
name = "pixi-build-python"
version = "*"
[package.host-dependencies]
python = ">={{ minimal_python_version.replace('py3', '3.') }}"
hatchling = "*"
uv = "*"

[dependencies]
{{ project_slug if "." not in project_slug else ('"' ~ project_slug ~ '"') }} = { path = "." }

[feature.test.dependencies]
pytest = "*"
pytest-cov = "*"
mypy = "*"
[feature.test.tasks]
test = "pytest"
test-coverage = "pytest --cov={{ project_slug_snake_case }} --cov-report=xml --cov-report=term-missing"

[feature.build.dependencies]
python = "*"
hatchling = "*"
python-build = "*"
twine = ">=6"
[feature.build.tasks]
build-wheel = "python -m build --no-isolation ."
check-wheel = "twine check dist/*"

[feature.lint.dependencies]
lefthook = "*"
ruff = "*"
prettier = "*"
taplo = "*"
pre-commit-hooks = "*"
typos = "*"
zizmor = "*"
reuse = "*"
[feature.lint.tasks]
pre-commit-install = "lefthook install"
lint = "lefthook run pre-commit --all-files"

# Pinned below 2.0 deliberately. MkDocs 2.0 drops the plugin system, rewrites
# theming and switches config to TOML with no migration path - it would take
# mkdocstrings, and so the whole API Reference, with it. Material's own advice
# is to pin `<2`; the successor they point at, Zensical, still calls its
# mkdocstrings integration preliminary, so this stays here until that settles.
[feature.docs.dependencies]
mkdocs = ">=1.6,<2"
mkdocs-material = ">=9.5"
mkdocstrings = ">=0.29"
mkdocstrings-python = ">=1.16"
mkdocs-bibtex = ">=2.16"
pymdown-extensions = ">=10.0"
mkdocs-macros-plugin = ">=1.0"
mkdocs-table-reader-plugin = ">=3.1"
# mkdocstrings formats signatures with one of these; without it every signature
# renders on a single unwrapped line.
ruff = "*"
[feature.docs.tasks.docs-serve]
cmd = "mkdocs serve"
[feature.docs.tasks.docs-build]
cmd = "mkdocs build --strict {{ dir }}"
args = ["dir"]

# Material prints a red MkDocs 2.0 advisory on every build. It is editorial, not
# a deprecation of anything used here, and in a CI log it reads as a failure -
# which matters because `--strict` means a real problem is also red.
[feature.docs.activation.env]
NO_MKDOCS_2_WARNING = "1"

[feature.template.dependencies]
copier = ">=9.16"
[feature.template.tasks.template-update]
cmd = "copier update --trust --skip-answered --skip-tasks ."

{% if minimal_python_version <= "py312" %}[feature.py312.dependencies]
python = "3.12.*"
{% endif %}{% if minimal_python_version <= "py313" %}[feature.py313.dependencies]
python = "3.13.*"
{% endif %}{% if minimal_python_version <= "py314" %}[feature.py314.dependencies]
python = "3.14.*"
{%- endif %}

[environments]
default = ["test", "build", "lint", "docs"]
template = ["template"]
{%- if minimal_python_version <= "py312" %}
py312 = ["py312", "test"]
{%- endif %}
{%- if minimal_python_version <= "py313" %}
py313 = ["py313", "test"]
{%- endif %}
{%- if minimal_python_version <= "py314" %}
py314 = ["py314", "test"]
{%- endif %}
